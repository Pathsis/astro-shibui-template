{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["astro/client", "preact"],
    "paths": {
      "@site-config": ["./site.config.js"],
      "@content-pages": ["./content/pages"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
