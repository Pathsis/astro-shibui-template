---
import { getCollection } from "astro:content";
import CategoryArchivePage from "../../components/CategoryArchivePage.astro";

export async function getStaticPaths() {
  // 中文分类归档路由:只从 blog-zh 收集分类空间
  // 英文侧的对称路由位于 /en/categories/[category].astro
  const postsZh = await getCollection("blog-zh", ({ data }) => !data.draft);

  const categories = new Set<string>();
  postsZh.forEach((post) => {
    post.data.categories?.forEach((category) => categories.add(category));
  });

  return Array.from(categories).map((category) => ({
    params: { category },
    props: { category },
  }));
}

const { category } = Astro.props;
---

<CategoryArchivePage category={category} lang="zh-cn" />
