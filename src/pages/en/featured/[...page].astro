---
import SingleColumnLayout from "../../../layouts/SingleColumnLayout.astro";
import FeaturedCardWall from "../../../components/FeaturedCardWall.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { extractFirstParagraph, truncateChars } from "../../../lib/excerpt";
import { extractFirstImageFromMarkdown, normalizeImagePath } from "../../../lib/image-path";
import { getLocalizedBlogPathById } from "../../../lib/post-url";
import { getPodcastEpisodeSlug, getPodcastUrl } from "../../../lib/podcast";
import { getFeaturedCardClass } from "../../../lib/featured-card-layout";
import { getBuildVersionToken } from "../../../lib/build-version";

const currentLang = "en" as const;

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const featuredPosts = await getCollection("blog-en", ({ data }) => !data.draft)
    .then((posts) => posts
      .filter((post) => post.data.feature)
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()));

  return paginate(featuredPosts, {
    pageSize: 10,
  });
};

const { page } = Astro.props as { page: Page<CollectionEntry<"blog-en">> };

const pageTitle = "Selected Articles";
const pageDescription = "Selected articles";
const podcastHint = " (Podcast available)";
const paginationVersion = getBuildVersionToken();
const paginationSignature = page.data
  .map((post) => `${post.id}:${post.data.date.toISOString()}`)
  .join("|");
const feedItems = await Promise.all(page.data.map(async (post, index) => {
  const postPath = getLocalizedBlogPathById(post.id, currentLang);
  const excerpt = truncateChars(
    extractFirstParagraph(post.body ?? "") || (post.data.description ?? ""),
    200
  );
  const coverImage = normalizeImagePath(post.data.images?.[0]) ?? extractFirstImageFromMarkdown(post.body ?? "");

  return {
    href: getRelativeLocaleUrl(currentLang, postPath),
    title: post.data.title,
    date: post.data.date,
    excerpt,
    coverImage,
    cardClass: await getFeaturedCardClass(coverImage, index),
    episode: post.data.podcast ? {
      slug: getPodcastEpisodeSlug(post.id, currentLang),
      title: post.data.title,
      url: getPodcastUrl(post.id, currentLang),
      articleUrl: getRelativeLocaleUrl(currentLang, postPath),
      date: post.data.date,
      lang: currentLang,
      description: post.data.description,
    } : undefined,
  };
}));
---

<SingleColumnLayout
  title={pageTitle}
  description={pageDescription}
  lang={currentLang}
  pageKind="section"
>
  <Fragment slot="head">
    {page.url.next && (
      <link rel="next" href={page.url.next} />
    )}
  </Fragment>

  <header class="featured-page-header">
    <h1>{pageTitle}</h1>
    <p class="featured-page-description">A curated list of articles I especially want readers to continue with, including long-form pieces with podcast versions.</p>
  </header>

  <FeaturedCardWall
    items={feedItems}
    sectionAriaLabel={pageTitle}
    paginationSignature={paginationSignature}
    paginationVersion={paginationVersion}
    paginationKey={page.url.current}
    nextUrl={page.url.next}
    loadMoreText="Load More"
    completeText="All loaded"
    podcastHint={podcastHint}
  />
</SingleColumnLayout>
