---
import { getCollection, type CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import FeaturedFeedPage from "../../../components/FeaturedFeedPage.astro";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const featuredPosts = await getCollection("blog-en", ({ data }) => !data.draft)
    .then((posts) => posts
      .filter((post) => post.data.feature)
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()));

  return paginate(featuredPosts, { pageSize: 10 });
};

const { page } = Astro.props as { page: Page<CollectionEntry<"blog-en">> };
---

<FeaturedFeedPage page={page} lang="en" />
