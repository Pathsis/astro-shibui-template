---
import { getCollection } from "astro:content";
import TagArchivePage from "../../../components/TagArchivePage.astro";

export async function getStaticPaths() {
  // 英文标签归档路由：从 blog-en 收集标签空间
  // 中文侧的对称路由位于 /tags/[tag].astro
  const postsEn = await getCollection("blog-en", ({ data }) => !data.draft);

  const tags = new Set<string>();
  postsEn.forEach((post) => {
    post.data.tags?.forEach((tag) => tags.add(tag));
  });

  return Array.from(tags).map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
---

<TagArchivePage tag={tag} lang="en" />
