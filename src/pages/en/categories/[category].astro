---
import { getCollection } from "astro:content";
import CategoryArchivePage from "../../../components/CategoryArchivePage.astro";

export async function getStaticPaths() {
  // 英文分类归档路由:只从 blog-en 收集分类空间
  // 中文侧的对称路由位于 /categories/[category].astro
  const postsEn = await getCollection("blog-en", ({ data }) => !data.draft);

  const categories = new Set<string>();
  postsEn.forEach((post) => {
    post.data.categories?.forEach((category) => categories.add(category));
  });

  return Array.from(categories).map((category) => ({
    params: { category },
    props: { category },
  }));
}

const { category } = Astro.props;
---

<CategoryArchivePage category={category} lang="en" />
