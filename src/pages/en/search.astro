---
import SingleColumnLayout from "../../layouts/SingleColumnLayout.astro";
import SearchComponent from "../../components/Search.astro";
import searchWidgetCssUrl from "../../styles/components/search-widget.css?url";
import { siteConfig } from "@site-config";

const description = siteConfig.descriptions.searchEn;
---

<SingleColumnLayout
  title="Search"
  description={description}
  isHome={false}
  pageKind="section"
>
  <Fragment slot="head">
    <link rel="stylesheet" href={searchWidgetCssUrl} />
  </Fragment>

  <article class="gh-content">
    <h1>Search</h1>
    <SearchComponent lang="en" />
  </article>
</SingleColumnLayout>
