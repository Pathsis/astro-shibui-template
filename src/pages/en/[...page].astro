---
import { getCollection, type CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import HomeFeedPage from "../../components/HomeFeedPage.astro";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = await getCollection("blog-en", ({ data }) => !data.draft)
    .then((posts) => posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()));

  return paginate(allPosts, { pageSize: 10 });
};

const { page } = Astro.props as { page: Page<CollectionEntry<"blog-en">> };
---

<HomeFeedPage page={page} lang="en" />
