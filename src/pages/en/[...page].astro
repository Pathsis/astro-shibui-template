---
import SingleColumnLayout from "../../layouts/SingleColumnLayout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { getLocalizedBlogPathById } from "../../lib/post-url";
import { extractFirstParagraph, truncateChars } from "../../lib/excerpt";
import { getBuildVersionToken } from "../../lib/build-version";
import { formatDateTimeMinute } from "../../lib/date";
import { siteConfig } from "@site-config";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = await getCollection("blog-en", ({ data }) => !data.draft)
    .then(posts => posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()));

  return paginate(allPosts, {
    pageSize: 10,
  });
};

const { page } = Astro.props as { page: Page<CollectionEntry<"blog-en">> };

// Page description
const description = siteConfig.descriptions.en;
const podcastHint = " (Podcast available)";
const paginationVersion = getBuildVersionToken();
const paginationSignature = page.data
  .map((post) => `${post.id}:${post.data.date.toISOString()}`)
  .join("|");
const isFirstPage = page.currentPage === 1;
---

<SingleColumnLayout
  title={siteConfig.title}
  description={description}
  isHome={true}
  pageKind={isFirstPage ? "home" : "page"}
>
  <Fragment slot="head">
    {page.url.next && (
      <link rel="next" href={page.url.next} />
    )}
  </Fragment>

  <section class="home-feed home-waterfall">
    <div
      class="home-waterfall-list shibui-feed"
      data-pagination-signature={paginationSignature}
      data-pagination-version={paginationVersion}
    >
      {page.data.map((post) => {
        const postUrl = `/en${getLocalizedBlogPathById(post.id, "en")}`;
        const excerpt = truncateChars(
          extractFirstParagraph(post.body ?? "") || (post.data.description ?? ""),
          200
        );
        return (
          <article class="home-waterfall-item">
            <header class="home-waterfall-meta">
              <time datetime={post.data.date.toISOString()}>
                {formatDateTimeMinute(post.data.date, "en")}
              </time>
            </header>
            <h2 class="home-waterfall-title">
              <a href={postUrl}>
                {post.data.title}
                {post.data.podcast && <span class="sr-only">{podcastHint}</span>}
              </a>
            </h2>
            {excerpt && <p class="home-waterfall-desc">{excerpt}</p>}
          </article>
        );
      })}
    </div>

    {page.url.next && (
      <button class="shibui-loadmore home-loadmore" type="button" data-next-url={page.url.next}>
        Load More
      </button>
    )}
  </section>
</SingleColumnLayout>
