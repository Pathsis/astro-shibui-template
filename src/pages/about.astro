<SingleColumnLayout
  title={pageTitle}
  description={pageDesc}
  pageKind="section"
>
  <Fragment slot="head">
    <link rel="stylesheet" href={aboutPageCssUrl} />
  </Fragment>

  <h1>{pageTitle}</h1>

  <Stats lang="zh-cn" />
  <WritingChart lang="zh-cn" />
  <article class="gh-content about-page-content">
    <AboutContent />
  </article>

