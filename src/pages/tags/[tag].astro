---
import { getCollection } from "astro:content";
import TagArchivePage from "../../components/TagArchivePage.astro";

export async function getStaticPaths() {
  // 中文标签归档路由：从 blog-zh 收集标签空间
  // 英文侧的对称路由位于 /en/tags/[tag].astro
  const postsZh = await getCollection("blog-zh", ({ data }) => !data.draft);

  const tags = new Set<string>();
  postsZh.forEach((post) => {
    post.data.tags?.forEach((tag) => tags.add(tag));
  });

  return Array.from(tags).map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
---

<TagArchivePage tag={tag} lang="zh-cn" />
