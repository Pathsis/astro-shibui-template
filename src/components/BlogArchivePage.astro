---
/**
 * BlogArchivePage — 双语归档页的共用渲染组件。
 * `/blog/index.astro` 和 `/en/blog/index.astro` 传 lang,本组件按年份分组渲染 + 内嵌搜索。
 */
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import SingleColumnLayout from "../layouts/SingleColumnLayout.astro";
import SearchComponent from "./Search.astro";
import searchWidgetCssUrl from "../styles/components/search-widget.css?url";
import { getLocalizedBlogPathById } from "../lib/post-url";
import { formatMonthDay, getDateYear } from "../lib/date";

interface Props {
  lang: "zh-cn" | "en";
}

const { lang } = Astro.props as Props;
const collectionName = lang === "en" ? "blog-en" : "blog-zh";

const allPosts = (await getCollection(collectionName, ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const postsByYear = allPosts.reduce((acc, post) => {
  const year = getDateYear(post.data.date);
  (acc[year] ||= []).push(post);
  return acc;
}, {} as Record<number, typeof allPosts>);

function getZodiac(year: number): string {
  const zodiacs = ["🐭", "🐮", "🐯", "🐰", "🐲", "🐍", "🐴", "🐑", "🐵", "🐔", "🐶", "🐷"];
  return zodiacs[(year + 8) % 12];
}

const isEn = lang === "en";
const pageTitle = isEn ? "Archive" : "归档";
const pageDescription = isEn ? "All articles archive" : "所有文章归档";
const podcastHint = isEn ? " (Podcast available)" : "（可收听播客）";
---

<SingleColumnLayout
  title={pageTitle}
  description={pageDescription}
  pageKind="section"
  lang={lang}
>
  <Fragment slot="head">
    <link rel="stylesheet" href={searchWidgetCssUrl} />
  </Fragment>

  <h1>{pageTitle}</h1>

  <SearchComponent lang={lang} />

  {Object.entries(postsByYear)
    .sort((a, b) => Number(b[0]) - Number(a[0]))
    .map(([year, posts]) => (
      <div>
        <h2 class="year-heading">{year} {getZodiac(Number(year))}</h2>
        <div class="time-list">
          <ul>
            {posts.map((post) => (
              <li>
                <span>{formatMonthDay(post.data.date)}</span>
                <div>
                  <a href={getRelativeLocaleUrl(lang, getLocalizedBlogPathById(post.id, lang))}>
                    {post.data.title}
                    {post.data.podcast && <span class="sr-only">{podcastHint}</span>}
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
</SingleColumnLayout>
