---
import { PodcastPlayButton } from "./PodcastPlayButton";
import type { PodcastEpisode } from "../lib/podcast";
import { formatDate } from "../lib/date";

interface FeaturedCardItem {
  href: string;
  title: string;
  date: Date;
  excerpt?: string;
  coverImage?: string;
  coverSrcset?: string;
  coverSizes?: string;
  /** 原始图片宽度 */
  imgWidth?: number;
  /** 原始图片高度 */
  imgHeight?: number;
  cardClass?: string;
  episode?: PodcastEpisode;
}

interface Props {
  items: FeaturedCardItem[];
  sectionAriaLabel: string;
  paginationSignature: string;
  paginationVersion: string;
  loadMoreText: string;
  completeText?: string;
  nextUrl?: string;
  podcastHint?: string;
  paginationKey: string;
  resetOnReload?: boolean;
}

const {
  items,
  sectionAriaLabel,
  paginationSignature,
  paginationVersion,
  loadMoreText,
  completeText,
  nextUrl,
  podcastHint = "",
  paginationKey,
  resetOnReload = true,
} = Astro.props as Props;

---

<section class="featured-card-section" aria-label={sectionAriaLabel}>
  <div
    class="featured-card-wall shibui-feed"
    data-pagination-signature={paginationSignature}
    data-pagination-version={paginationVersion}
    data-pagination-key={paginationKey}
    data-pagination-reset-on-reload={resetOnReload ? "true" : "false"}
  >
    {items.map((item) => (
      <article class={`featured-card ${item.cardClass ?? "featured-card--square"}`}>
        <a class="featured-card-link" href={item.href} aria-label={item.title} data-astro-prefetch="tap">
          <span class="sr-only">{item.title}</span>
        </a>
        {item.coverImage ? (
          <img
            class="featured-card-image"
            src={item.coverImage}
            srcset={item.coverSrcset}
            sizes={item.coverSizes}
            alt=""
            loading="lazy"
            fetchpriority="low"
            decoding="async"
            width={item.imgWidth}
            height={item.imgHeight}
          />
        ) : (
          <div class="featured-card-image featured-card-image--fallback" aria-hidden="true"></div>
        )}
        <div class="featured-card-scrim" aria-hidden="true"></div>
        <div class="featured-card-body">
          <time class="featured-card-date" datetime={item.date.toISOString()}>
            {formatDate(item.date)}
          </time>
          <h2 class="featured-card-title">
            {item.title}
            {item.episode && podcastHint && <span class="sr-only">{podcastHint}</span>}
          </h2>
          {item.excerpt && <p class="featured-card-excerpt">{item.excerpt}</p>}
        </div>
        {item.episode && (
          <div class="featured-card-action">
            <PodcastPlayButton episode={item.episode} client:idle />
          </div>
        )}
      </article>
    ))}
  </div>

  {nextUrl && (
    <button
      class="shibui-loadmore home-loadmore featured-card-loadmore"
      type="button"
      data-next-url={nextUrl}
      data-complete-text={completeText}
      aria-label={loadMoreText}
    >
      {loadMoreText}
    </button>
  )}
</section>
