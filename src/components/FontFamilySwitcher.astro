---
---

<span class="font-family-switcher" data-font-family-switcher aria-label="字体切换">
  <button
    type="button"
    class="font-family-btn font-family-btn-serif"
    data-font="stsong"
    aria-pressed="true"
    aria-label="宋体"
  >
    A
  </button>
  <span class="font-family-switcher-sep" aria-hidden="true">·</span>
  <button
    type="button"
    class="font-family-btn font-family-btn-sans"
    data-font="sans"
    aria-pressed="false"
    aria-label="无衬线字体"
  >
    A
  </button>
</span>

<style>
  .font-family-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    height: 1em;
    font-family: var(--font-family-sans);
    font-size: 0.86rem;
    color: color-mix(in srgb, var(--color-text-muted) 88%, var(--color-text-primary) 12%);
  }

  .font-family-switcher-sep {
    opacity: 0.68;
    user-select: none;
  }

  .font-family-btn {
    appearance: none;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    opacity: 0.86;
    line-height: 1;
    height: 1em;
    min-height: 1em;
    max-height: 1em;
    overflow: hidden;
    transition: color 0.18s ease, opacity 0.18s ease;
  }

  .font-family-btn:hover {
    color: var(--color-text-primary);
    opacity: 1;
  }

  .font-family-btn[aria-pressed="true"] {
    color: var(--color-text-primary);
    opacity: 1;
    font-weight: 600;
    cursor: default;
  }

  .font-family-btn-serif {
    font-family: Georgia, "Times New Roman", serif;
  }

  .font-family-btn-sans {
    font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
</style>

<script>
  import { trackUmami } from "../lib/analytics";

  (function () {
    if (typeof window === "undefined") return;

    const key = "shibui-font-family";
    const readSavedFont = function () {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    };

    const initFontFamilySwitcher = function () {
      const switcher = document.querySelector("[data-font-family-switcher]") as HTMLElement | null;
      if (!switcher) return;

      const buttons = switcher.querySelectorAll("[data-font]") as NodeListOf<HTMLElement>;
      const update = function (name: string) {
        buttons.forEach(function (btn) {
          const active = btn.dataset.font === name;
          btn.setAttribute("aria-pressed", String(active));
        });
      };

      // 事件监听只绑定一次；ClientRouter 切换页面后 DOM 会替换，需要重新同步按钮状态
      if (!switcher.dataset.initialized) {
        switcher.dataset.initialized = "true";
        buttons.forEach(function (btn) {
          btn.addEventListener("click", function () {
            const name = btn.dataset.font || "stsong";
            // 已选中的字体不再重复切换和上报
            if (btn.getAttribute("aria-pressed") === "true") return;
            const switchFont = (window as any).switchFontFamily;
            if (typeof switchFont === "function") {
              switchFont(name);
            }
            update(name);
            trackUmami("font-family-switch", { fontFamily: name });
          });
        });
      }

      // 直接从持久化存储读取，避免依赖 DOM 初始化时机
      const saved = readSavedFont();
      update(saved === "sans" ? "sans" : "stsong");
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initFontFamilySwitcher, { once: true });
    } else {
      initFontFamilySwitcher();
    }
    document.addEventListener("astro:page-load", initFontFamilySwitcher);
  })();
</script>
