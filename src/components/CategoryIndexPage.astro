---
/**
 * CategoryIndexPage — 双语分类总览页的共用渲染组件。
 * `/categories/index.astro` 和 `/en/categories/index.astro` 传入自己的 lang,
 * 本组件从对应集合汇总分类 + 计数。
 */
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import SingleColumnLayout from "../layouts/SingleColumnLayout.astro";
import { buildCategoryGroups, getCategoryCorePath } from "../lib/taxonomy";

interface Props {
  lang: "zh-cn" | "en";
}

const { lang } = Astro.props as Props;
const collectionName = lang === "en" ? "blog-en" : "blog-zh";

const allPosts = await getCollection(collectionName, ({ data }) => !data.draft);

const categoryGroups = buildCategoryGroups(
  allPosts.map((post) => post.data.categories),
  lang,
);

const isEn = lang === "en";
const pageTitle = isEn ? "Categories" : "分类";
const pageDescription = isEn ? "All categories" : "所有分类";
---

<SingleColumnLayout
  title={pageTitle}
  description={pageDescription}
  pageKind="taxonomy"
  lang={lang}
>
  <h1>{pageTitle}</h1>

  <div class="terms-list">
    <ul>
      {categoryGroups.map(({ canonicalLabel, count }) => (
        <li>
          <a href={getRelativeLocaleUrl(lang, getCategoryCorePath(canonicalLabel))} data-astro-prefetch>
            [{canonicalLabel}] ({count})
          </a>
        </li>
      ))}
    </ul>
  </div>
</SingleColumnLayout>
