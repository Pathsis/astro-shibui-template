---
/**
 * Footer 组件 - 页脚（参考 Ghost Journal 设计）
 *
 * 功能：
 * 1. 版权信息
 * 2. 统计信息
 * 3. 构建信息
 * 4. GitHub 链接
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import { siteConfig } from "@site-config";

interface Props {
  currentLang: "zh-cn" | "en";
  buildInfoText: string;
}

const { currentLang, buildInfoText } = Astro.props;

const homeUrl = getRelativeLocaleUrl(currentLang, "/");

const copyrightHtml = `&copy; <a href="${homeUrl}" class="js-home-link">${siteConfig.title}</a>. All rights reserved. <a href="${siteConfig.branding.templateRepoUrl}" target="_blank" rel="noopener" aria-label="GitHub" class="icon-link gh-template-link"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="height: 1em; width: auto;"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg></a>`;
---

<footer class="gh-foot">
  <div class="gh-foot-inner">
    <!-- 版权信息 -->
    <div class="gh-copyright" set:html={copyrightHtml} />

    <!-- 构建信息 -->
    <div class="gh-powered-by">
      <span class="gh-build">{buildInfoText}</span>
      <svg aria-hidden="true" class="gh-build-check" viewBox="0 0 16 16" width="16" height="16" fill="#3fb950">
        <title>Success</title>
        <path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"></path>
      </svg>
    </div>
  </div>
</footer>

<style>
  /* ===== Ghost Journal 风格 Footer 样式 ===== */

  /* Footer 基础样式 - 全幅 */
  .gh-foot {
    width: 100%;
    max-width: none;
    color: var(--color-text-muted);
    padding-top: var(--spacing-lg);
    padding-bottom: var(--spacing-lg);
    margin-top: calc(var(--spacing-lg) * 1.35);
    white-space: nowrap;
    position: relative;
  }

  /* Footer 内部容器（限制宽度） */
  .gh-foot-inner {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 var(--spacing-lg);
    display: flex;
    flex-direction: column; /* 垂直排列 */
    gap: calc(var(--spacing-xs) * 1.2);
    font-size: 1.8rem; /* 与正文字号一致 */
    align-items: center; /* 居中显示 */
    text-align: center;
  }

  /* 版权信息 */
  .gh-copyright {
    font-size: 1rem; /* 与正文字号一致 */
  }

  .gh-foot p {
    margin-bottom: 0;
  }

  .gh-copyright :global(a) {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
    border-bottom: none;
  }

  .gh-copyright :global(a:hover) {
    color: var(--color-text-primary);
    opacity: 1;
  }

  .gh-copyright :global(.gh-template-link) {
    margin-left: 4px;
  }

  /* 构建信息和 GitHub */
  .gh-powered-by {
    font-size: 1rem; /* 与正文字号一致 */
    font-family: var(--font-family-sans);
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    text-align: center;
  }

  .gh-build {
    opacity: 0.8;
  }

  .gh-build-check {
    flex-shrink: 0;
  }

  /* ===== 响应式：移动端 ===== */
  @media (max-width: 767px) {
    .gh-foot {
      padding-top: var(--spacing-md);
      padding-bottom: var(--spacing-md);
      margin-top: calc(var(--spacing-lg) * 1.15);
    }

    .gh-foot-inner {
      padding: 0 var(--spacing-md);
      gap: calc(var(--spacing-xs) * 0.85);
    }
  }
</style>
