---
import { getRelativeLocaleUrl } from "astro:i18n";
import { siteConfig } from "@site-config";
import { getPostStats } from "../lib/posts";

interface Props {
  currentLang: "zh-cn" | "en";
}

const { currentLang } = Astro.props;

const { postCount, totalWords, firstYear } = await getPostStats(currentLang);

const numberFmt = new Intl.NumberFormat("en-US");
const leftMeta = currentLang === "en"
  ? `${numberFmt.format(postCount)} posts · ${numberFmt.format(totalWords)} words · since ${firstYear}`
  : `${numberFmt.format(postCount)} 篇文章 · ${numberFmt.format(totalWords)} 字 · 自 ${firstYear} 年`;
const homeUrl = getRelativeLocaleUrl(currentLang, "/");
const homeTopUrl = `${homeUrl}#top`;
const siteTitle = currentLang === "en" ? siteConfig.titleEn : siteConfig.title;
const copyrightSeparator = currentLang === "en" ? ". " : "。";
const copyrightText = currentLang === "en"
  ? "All rights reserved."
  : "保留所有权利。";

const branch = process.env.VERCEL_GIT_COMMIT_REF || process.env.GIT_BRANCH || "";
const commitSha = process.env.VERCEL_GIT_COMMIT_SHA || process.env.GIT_COMMIT || "";
const shortSha = commitSha ? commitSha.slice(0, 7) : "";
const displayBranch = branch || "main";
const templateRepoUrl = siteConfig.branding.templateRepoUrl;
---

<footer class="gh-foot">
  <div class="gh-foot-inner">
    <div class="gh-foot-meta">
      <span class="gh-foot-copy">
        &copy; <a href={homeTopUrl} class="js-home-link">{siteTitle}</a>{copyrightSeparator}{copyrightText}
      </span>
      <span class="gh-foot-stats">{leftMeta}</span>
    </div>
    <div class="gh-foot-git" aria-label="git version">
      <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
        <path fill="currentColor" d="M3.75 2a1.75 1.75 0 1 0 1.5 2.65v6.85a1.75 1.75 0 1 0 1.5 0V8.75h4.69a1.75 1.75 0 1 0 0-1.5H6.75V4.65A1.75 1.75 0 0 0 3.75 2Zm0 1a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5Zm8.5 4a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5Zm-6.25 5a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5Z"/>
      </svg>
      <span>{displayBranch}</span>
      {shortSha && <span class="dot">·</span>}
      {shortSha && <span>{shortSha}</span>}
      <span class="dot" aria-hidden="true">·</span>
      <a
        href={templateRepoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="gh-social-link"
        aria-label="Astro Shibui template repository"
      >
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
          <path fill="currentColor" d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
      <a
        href="https://x.com/wingedwork"
        target="_blank"
        rel="noopener noreferrer me"
        class="gh-social-link"
        aria-label="X (Twitter)"
      >
        <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true">
          <path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .gh-foot {
    --footer-height: 64px;
    width: 100%;
    max-width: none;
    position: relative;
    display: flex;
    align-items: center;
    margin-top: calc(var(--spacing-lg) * 1.6);
    min-height: var(--footer-height);
    padding: 0;
    color: var(--color-text-muted);
  }

  .gh-foot-inner {
    width: 100%;
    max-width: none;
    margin: 0;
    padding-inline: var(--hanging-image-edge-gap, 2rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--spacing-md);
  }

  .gh-foot-meta {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-family: var(--font-family-serif);
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    color: color-mix(in srgb, var(--color-text-muted) 92%, var(--color-text-primary) 8%);
  }

  .gh-foot-copy a {
    border-bottom: none;
    text-decoration: none;
  }

  .gh-foot-git {
    display: inline-flex;
    align-items: center;
    justify-self: end;
    gap: 0.38rem;
    font-family: var(--font-family-sans);
    font-size: 0.86rem;
    color: color-mix(in srgb, var(--color-text-muted) 88%, var(--color-text-primary) 12%);
    white-space: nowrap;
  }

  .gh-foot-git svg {
    opacity: 0.86;
  }

  .gh-foot-git .dot {
    opacity: 0.68;
  }

  .gh-social-link {
    display: inline-flex;
    align-items: center;
    color: inherit;
    border-bottom: none;
    text-decoration: none;
    opacity: 0.86;
    transition: color 0.18s ease, opacity 0.18s ease;
  }

  .gh-social-link:hover {
    color: var(--color-text-primary);
    opacity: 1;
  }

  @media (max-width: 767px) {
    .gh-foot {
      margin-top: calc(var(--spacing-lg) * 1.25);
      min-height: auto;
      padding-top: calc(var(--spacing-md) * 0.9);
      padding-bottom: calc(var(--spacing-md) * 0.9);
    }

    .gh-foot-inner {
      padding-inline: var(--spacing-md);
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.45rem;
    }

    .gh-foot-meta {
      font-size: 0.9rem;
    }

  }
</style>
