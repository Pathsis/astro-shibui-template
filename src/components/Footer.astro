---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { siteConfig } from "@site-config";
import { countWords } from "../lib/word-count";

interface Props {
  currentLang: "zh-cn" | "en";
}

const { currentLang } = Astro.props;

const collectionName = currentLang === "en" ? "blog-en" : "blog-zh";
const allPosts = await getCollection(collectionName, ({ data }) => !data.draft);
const posts = allPosts.filter((post) => post.id && !post.id.startsWith("_"));
const postCount = posts.length;
const totalWords = posts.reduce((sum, post) => sum + countWords(post.body ?? "", currentLang), 0);
const firstYear = posts.reduce((min, post) => {
  const year = new Date(post.data.date).getFullYear();
  return Number.isFinite(year) ? Math.min(min, year) : min;
}, new Date().getFullYear());

const numberFmt = new Intl.NumberFormat("en-US");
const leftMeta = currentLang === "en"
  ? `${numberFmt.format(postCount)} posts · ${numberFmt.format(totalWords)} words · since ${firstYear}`
  : `${numberFmt.format(postCount)} 篇文章 · ${numberFmt.format(totalWords)} 字 · 自 ${firstYear} 年`;
const homeUrl = getRelativeLocaleUrl(currentLang, "/");
const copyrightText = currentLang === "en"
  ? "All rights reserved."
  : "保留所有权利。";

const branch = process.env.VERCEL_GIT_COMMIT_REF || process.env.GIT_BRANCH || "";
const commitSha = process.env.VERCEL_GIT_COMMIT_SHA || process.env.GIT_COMMIT || "";
const shortSha = commitSha ? commitSha.slice(0, 7) : "";
const displayBranch = branch || "main";
---

<footer class="gh-foot">
  <div class="gh-foot-inner">
    <div class="gh-foot-meta">
      <span class="gh-foot-copy">
        &copy; <a href={homeUrl} class="js-home-link">{siteConfig.title}</a>. {copyrightText}
      </span>
      <span class="gh-foot-stats">{leftMeta}</span>
    </div>
    <div class="gh-foot-git" aria-label="git version">
      <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
        <path fill="currentColor" d="M3.75 2a1.75 1.75 0 1 0 1.5 2.65v6.85a1.75 1.75 0 1 0 1.5 0V8.75h4.69a1.75 1.75 0 1 0 0-1.5H6.75V4.65A1.75 1.75 0 0 0 3.75 2Zm0 1a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5Zm8.5 4a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5Zm-6.25 5a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5Z"/>
      </svg>
      <span>{displayBranch}</span>
      {shortSha && <span class="dot">·</span>}
      {shortSha && <span>{shortSha}</span>}
    </div>
  </div>
</footer>

<style>
  .gh-foot {
    --footer-height: 64px;
    width: 100%;
    max-width: none;
    position: relative;
    display: flex;
    align-items: center;
    margin-top: calc(var(--spacing-lg) * 1.6);
    min-height: var(--footer-height);
    padding: 0;
    color: var(--color-text-muted);
  }

  .gh-foot-inner {
    width: 100%;
    max-width: none;
    margin: 0;
    padding-inline: var(--hanging-image-edge-gap, 2rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--spacing-md);
  }

  .gh-foot-meta {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-family: var(--font-family-serif);
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    color: color-mix(in srgb, var(--color-text-muted) 92%, var(--color-text-primary) 8%);
  }

  .gh-foot-copy a {
    border-bottom: none;
    text-decoration: none;
  }

  .gh-foot-git {
    display: inline-flex;
    align-items: center;
    justify-self: end;
    gap: 0.38rem;
    font-family: var(--font-family-sans);
    font-size: 0.86rem;
    color: color-mix(in srgb, var(--color-text-muted) 88%, var(--color-text-primary) 12%);
    white-space: nowrap;
  }

  .gh-foot-git svg {
    opacity: 0.86;
  }

  .gh-foot-git .dot {
    opacity: 0.68;
  }

  @media (max-width: 767px) {
    .gh-foot {
      margin-top: calc(var(--spacing-lg) * 1.25);
      min-height: auto;
      padding-top: calc(var(--spacing-md) * 0.9);
      padding-bottom: calc(var(--spacing-md) * 0.9);
    }

    .gh-foot-inner {
      padding-inline: var(--spacing-md);
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.45rem;
    }

    .gh-foot-meta {
      font-size: 0.9rem;
    }

  }
</style>
