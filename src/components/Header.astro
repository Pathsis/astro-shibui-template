---
/**
 * Header 组件 - Ghost Journal 风格（Stacked 布局）
 *
 * 结构：
 * - 第一行：Logo（居中）+ 语言切换器 + 汉堡菜单按钮
 * - 第二行：导航菜单（全幅，上下各有一条横线）
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { siteConfig } from "@site-config";

interface Props {
  currentLang: "zh-cn" | "en";
  pageKind: "home" | "section" | "taxonomy" | "term" | "article";
  hasTranslation?: boolean;
  targetSlug?: string;
}

const { currentLang, pageKind, hasTranslation, targetSlug } = Astro.props;

// 获取当前语言的首页链接
const homeUrl = getRelativeLocaleUrl(currentLang, "/");

// 导航链接配置
const navLinks = {
  archive: getRelativeLocaleUrl(currentLang, "/blog/"),
  about: getRelativeLocaleUrl(currentLang, "/about/"),
  tags: getRelativeLocaleUrl(currentLang, "/tags/"),
  feed: getRelativeLocaleUrl(currentLang, "/about/") + "#subscribe",
};

// 导航文字（根据语言）
const navText = currentLang === "en"
  ? { home: "Home", archive: "Archive", about: "About", tags: "Tags", feed: "Feed" }
  : { home: "首页", archive: "归档", about: "关于", tags: "标签", feed: "订阅" };

// 站点名称
const siteTitle = siteConfig.title;

// 汉堡菜单提示
const menuLabel = currentLang === "en" ? "Toggle menu" : "切换菜单";
const homeAriaLabel = currentLang === "en" ? "Back to home" : "返回首页";
---

<header class="gh-head is-head-stacked">
  <div class="gh-head-inner">
    <!-- 第一行：Logo（居中）+ 汉堡菜单按钮 -->
    <div class="gh-head-brand">
      <a class="gh-head-logo js-home-link" href={homeUrl} aria-label={homeAriaLabel}>
        {siteTitle}
      </a>
    </div>

    <div class="gh-head-actions">
      <!-- 汉堡菜单按钮（移动端可见） -->
      <button class="gh-burger" aria-label={menuLabel} aria-expanded="false" aria-controls="site-mobile-menu"></button>
    </div>
  </div>

  <!-- 第二行：导航菜单（全幅，在 gh-head-inner 外面） -->
  <nav class="gh-head-menu" id="site-menu">
    <div class="gh-head-inner">
      <a class="gh-head-menu-home" href={homeUrl}>{navText.home}</a>
      <a href={navLinks.archive}>{navText.archive}</a>
      <a href={navLinks.about}>{navText.about}</a>
      <a href={navLinks.tags}>{navText.tags}</a>
      <a href={navLinks.feed}>{navText.feed}</a>

      <!-- 语言切换器 -->
      <div class="gh-head-lang-switcher">
        <LanguageSwitcher
          pageKind={pageKind}
          lang={currentLang}
          hasTranslation={hasTranslation}
          targetSlug={targetSlug}
        />
      </div>
    </div>
  </nav>
</header>

<style>
  /* ===== Ghost Journal Stacked 布局样式 ===== */

  /* CSS 变量 */
  :root {
    --head-nav-gap: 2.8rem;
    --head-nav-content-max: 52rem;
  }

  /* Header 基础样式 - 全幅 */
  .gh-head {
    position: relative;
    width: 100%;
    max-width: none !important; /* 覆盖 global.css 中的 header max-width 限制 */
    z-index: 100;
    background: var(--color-bg-primary);
    transition: background-color 0.3s ease;
  }

  /* Header 内部容器（限制宽度） */
  .gh-head-inner {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 var(--spacing-lg);
    position: relative;
    z-index: 10; /* 确保内部链接可点击 */
    pointer-events: auto !important; /* 强制允许点击 */
  }

  /* Stacked 布局的 Grid 结构（第一行） */
  .is-head-stacked .gh-head-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--head-nav-gap);
  }

  /* 第一行：Logo（居中） */
  .is-head-stacked .gh-head-brand {
    display: flex;
    grid-column-start: 2;
    grid-row-start: 1;
    height: 80px;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 100; /* 确保链接可点击 */
  }

  /* 上横线（在第一行 80px 下方，全幅） */
  .gh-head::before {
    background-color: var(--color-border);
    content: "";
    height: 1px;
    left: 0;
    position: absolute;
    top: 80px;
    width: 100vw;
    z-index: 1; /* 横线在底层 */
    pointer-events: none; /* 不阻挡点击事件 */
  }

  /* 下横线（在第一行 80px + 导航 56px 下方，全幅） */
  .gh-head::after {
    background-color: var(--color-border);
    content: "";
    height: 1px;
    left: 0;
    position: absolute;
    top: 136px;
    width: 100vw;
    z-index: 1; /* 横线在底层 */
    pointer-events: none; /* 不阻挡点击事件 */
  }

  /* 站点 Logo */
  .gh-head-logo {
    font-family: var(--font-family-heading);
    font-size: 1rem; /* 与正文字号一致 */
    font-weight: 700;
    color: var(--color-text-primary);
    text-decoration: none !important; /* 强制去掉下划线 */
    letter-spacing: -0.02em;
    transition: opacity 0.2s ease;
    border-bottom: none !important;
    display: block;
    position: relative;
    z-index: 100 !important; /* 强制在最上层 */
  }

  .gh-head-logo:hover,
  .gh-head-logo:visited,
  .gh-head-logo:active,
  .gh-head-logo:focus {
    color: var(--color-text-primary);
    text-decoration: none !important;
    border-bottom: none !important;
    opacity: 0.8;
  }

  /* 所有导航链接去掉下划线 */
  .gh-head-menu a {
    color: var(--color-text-primary);
    text-decoration: none !important;
    border-bottom: none !important;
    transition: opacity 0.2s ease;
    font-size: var(--font-size-small);
    white-space: nowrap;
    word-break: keep-all;
    overflow-wrap: normal;
  }

  .gh-head-menu a:hover,
  .gh-head-menu a:visited,
  .gh-head-menu a:active,
  .gh-head-menu a:focus {
    color: var(--color-text-primary);
    text-decoration: none !important;
    border-bottom: none !important;
    opacity: 0.8;
  }

  /* 语言切换器容器 */
  .gh-head-lang-switcher {
    display: inline-flex;
    align-items: center;
  }

  .gh-head-lang-switcher :global(.language-switcher) {
    margin-left: 0;
  }

  .gh-head-lang-switcher :global(.lang-link) {
    color: var(--color-text-primary);
    text-decoration: none !important;
    border-bottom: none !important;
    font-size: var(--font-size-small);
    transition: opacity 0.2s ease;
    white-space: nowrap;
    word-break: keep-all;
    overflow-wrap: normal;
  }

  .gh-head-lang-switcher :global(.lang-link:hover),
  .gh-head-lang-switcher :global(.lang-link:visited),
  .gh-head-lang-switcher :global(.lang-link:active),
  .gh-head-lang-switcher :global(.lang-link:focus) {
    color: var(--color-text-primary);
    text-decoration: none !important;
    border-bottom: none !important;
    opacity: 0.8;
  }

  /* 第一行：语言切换器 + 汉堡菜单（在两端） */
  .is-head-stacked .gh-head-actions {
    grid-column: 1/4;
    grid-row-start: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 10; /* 确保链接可点击 */
  }

  /* 第二行：导航菜单（全幅，在 gh-head-inner 外面） */
  .gh-head-menu {
    width: 100%;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    font-size: var(--font-size-small);
    font-weight: 500;
    letter-spacing: 0.01em;
    text-transform: none;
  }

  /* 导航菜单内部容器（独立中宽栅格） */
  .gh-head-menu .gh-head-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--head-nav-gap);
    width: min(100%, var(--head-nav-content-max));
    margin: 0;
    padding: 0 clamp(0.9rem, 2.2vw, 1.8rem);
    box-sizing: border-box;
    flex-wrap: nowrap;
    height: 100%;
    position: relative;
    z-index: 10; /* 确保导航链接可点击 */
  }

  .gh-head-menu .gh-head-inner > a,
  .gh-head-lang-switcher {
    flex: 0 0 auto;
    min-width: max-content;
  }


  /* 汉堡菜单按钮 */
  .gh-burger {
    appearance: none;
    background: transparent;
    border: none;
    cursor: pointer;
    display: none;
    height: 32px;
    margin-right: 0;
    outline: none;
    padding: 0;
    position: relative;
    width: 32px;
  }

  .gh-burger::before,
  .gh-burger::after {
    background-color: var(--color-text-primary);
    content: "";
    height: 2px;
    left: 7px;
    position: absolute;
    border-radius: 1px;
    transition: all 0.25s ease-in-out;
    width: 18px;
  }

  .gh-burger::before {
    top: 10px;
  }

  .gh-burger::after {
    top: 20px;
  }

  /* 菜单打开时的汉堡按钮动画 */
  body.menu-open .gh-burger::before {
    top: 15px;
    left: 7px;
    width: 18px;
    transform: rotate(45deg);
  }

  body.menu-open .gh-burger::after {
    top: 15px;
    left: 7px;
    width: 18px;
    transform: rotate(-45deg);
  }

  /* ===== 响应式：移动端 ===== */
  @media (max-width: 768px) {
    .gh-head {
      position: sticky;
      top: 0;
      z-index: 520;
    }

    @supports (-webkit-touch-callout: default) {
      /*
       * iOS Safari 上保留 fixed/sticky 的汉堡按钮体验，
       * 但让 header 本体退出贴顶状态，避免 iOS 26 将其当作顶部栏取色来源。
       */
      .gh-head {
        position: relative;
        top: auto;
      }
    }

    .gh-head-inner {
      /* 移动视图下取消 --container-width (626px) 的最大宽度约束：
       * 否则在 iPad mini 等 626px < viewport ≤ 768px 的设备上，
       * .gh-head-inner 会被限在 626px 然后 margin:0 auto 居中，
       * 表现为 Logo 看起来相对视口"没有完全左对齐"（实际是相对居中的
       * 内部容器左对齐）。手机视口本来就 < 626px，这个改动是 no-op。*/
      max-width: none;
      padding: 0 var(--spacing-md);
    }

    .is-head-stacked .gh-head-inner {
      grid-template-columns: 1fr auto 1fr;
      gap: var(--spacing-md);
    }

    .is-head-stacked .gh-head-brand {
      grid-column: 1 / 3;
      min-height: 64px;
      justify-content: flex-start;
    }

    .gh-head::before,
    .gh-head::after {
      display: none;
    }

    .gh-burger {
      display: block;
      position: fixed;
      top: 16px;
      right: 20px;
      z-index: 560;
    }

    .is-head-stacked .gh-head-actions {
      grid-column: 3;
      justify-content: flex-end;
      z-index: 40;
    }

    .gh-head-menu {
      display: none;
    }

    body.menu-open {
      overscroll-behavior: none;
    }

    body.menu-open .gh-head {
      background: var(--color-bg-primary);
    }

    @supports (-webkit-touch-callout: default) {
      body.menu-open .gh-head {
        background: transparent;
      }
    }

    body.menu-open .gh-head-brand {
      opacity: 0;
      visibility: hidden;
    }
  }

  /* ===== 可访问性 ===== */
  .gh-burger:focus-visible {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 2px;
    border-radius: 4px;
  }
</style>
