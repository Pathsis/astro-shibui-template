# Search
PUBLIC_ALGOLIA_APP_ID=
PUBLIC_ALGOLIA_SEARCH_KEY=
PUBLIC_ALGOLIA_INDEX_NAME=

# Optional analytics
PUBLIC_UMAMI_SCRIPT_SRC=
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_HOSTS=

PUBLIC_CLARITY_PROJECT_ID=
PUBLIC_CLARITY_HOSTS=

# Optional comments
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=
PUBLIC_GISCUS_MAPPING=pathname
PUBLIC_GISCUS_STRICT=0
PUBLIC_GISCUS_REACTIONS_ENABLED=1
PUBLIC_GISCUS_EMIT_METADATA=0
PUBLIC_GISCUS_INPUT_POSITION=top
PUBLIC_GISCUS_THEME=preferred_color_scheme

# Optional site behavior
PUBLIC_ENABLE_CLIENT_ROUTER=true
PUBLIC_ENABLE_GOOGLE_FONTS=false
PUBLIC_ENABLE_IMAGE_CDN=false
PUBLIC_SOCIAL_IMAGE_VERSION=

# Optional image CDN
PUBLIC_IMAGEKIT_URL_ENDPOINT=
PUBLIC_IMAGEKIT_TRANSFORMATION=f-auto,q-auto
PUBLIC_IMAGEKIT_SOCIAL_TRANSFORMATION=f-auto,q-auto,w-1200,h-630,fo-auto
PUBLIC_IMAGEKIT_MEDIA_TRANSFORMATION=f-auto,q-auto,w-1024,h-1024,fo-auto

# ImageKit upload
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_SYNC_SOURCE_DIR=public/images
IMAGEKIT_SYNC_REMOTE_FOLDER=/images
IMAGEKIT_SYNC_GENERATED_SOCIAL_SOURCE_DIR=public/generated/social
IMAGEKIT_SYNC_GENERATED_SOCIAL_REMOTE_FOLDER=/generated/social
IMAGEKIT_SYNC_GENERATED_MEDIA_SOURCE_DIR=public/generated/media
IMAGEKIT_SYNC_GENERATED_MEDIA_REMOTE_FOLDER=/generated/media
