# =============================================================================
# Copy to `.env` for local development.
#
# Sync every `PUBLIC_*` value below to Vercel → Project Settings → Environment
# Variables → Production (and Preview if needed).
#
# Do NOT put `IMAGEKIT_PRIVATE_KEY` or `ALGOLIA_ADMIN_KEY` on Vercel unless a
# build script there explicitly needs them. ImageKit upload runs locally before
# deploy; social/media image cropping is handled by ImageKit at request time.
# =============================================================================

# Search
PUBLIC_ALGOLIA_APP_ID=
PUBLIC_ALGOLIA_SEARCH_KEY=
PUBLIC_ALGOLIA_INDEX_NAME=
ALGOLIA_ADMIN_KEY=

# Optional analytics
PUBLIC_UMAMI_SCRIPT_SRC=
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_HOSTS=
PUBLIC_UMAMI_PERFORMANCE=true

PUBLIC_CLARITY_PROJECT_ID=
PUBLIC_CLARITY_HOSTS=

# Optional comments
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=
PUBLIC_GISCUS_MAPPING=pathname
PUBLIC_GISCUS_STRICT=0
PUBLIC_GISCUS_REACTIONS_ENABLED=1
PUBLIC_GISCUS_EMIT_METADATA=0
PUBLIC_GISCUS_INPUT_POSITION=top
PUBLIC_GISCUS_THEME=preferred_color_scheme

# Optional site behavior
PUBLIC_ENABLE_CLIENT_ROUTER=true
PUBLIC_ENABLE_GOOGLE_FONTS=false
PUBLIC_ENABLE_WEB_FONTS=true
PUBLIC_ENABLE_IMAGE_CDN=true
PUBLIC_SOCIAL_IMAGE_VERSION=

# 字体切换：项目打包 STSong（宋体）作为衬线字体，无衬线直接使用系统 sans-serif。
# 默认使用 STSong；用户在页面加载后可在浏览器控制台执行：
#   window.switchFontFamily('sans')   // 切换到无衬线
#   window.switchFontFamily('stsong') // 切换回宋体
# 偏好会写入 localStorage（key: shibui-font-family），下次访问自动生效。

# Image CDN — must match Vercel Production
PUBLIC_IMAGEKIT_URL_ENDPOINT=
PUBLIC_IMAGEKIT_TRANSFORMATION=f-auto,q-auto,w-1280,c-at_max
PUBLIC_IMAGEKIT_BODY_TRANSFORMATION=
PUBLIC_IMAGEKIT_COVER_TRANSFORMATION=f-auto,q-auto,w-400,c-at_max
PUBLIC_IMAGEKIT_FEATURED_COVER_TRANSFORMATION=f-auto,q-auto,w-800,c-at_max
PUBLIC_IMAGEKIT_GENERATED_TRANSFORMATION=f-auto,q-auto
PUBLIC_IMAGEKIT_SOCIAL_TRANSFORMATION=f-auto,q-auto,w-1200,h-630,fo-auto
PUBLIC_IMAGEKIT_SOCIAL_FALLBACK_TRANSFORMATION=f-auto,q-auto
PUBLIC_IMAGEKIT_MEDIA_TRANSFORMATION=f-auto,q-auto,w-1024,h-1024,fo-auto

# ImageKit upload — local only
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_SYNC_SOURCE_DIR=public/images
IMAGEKIT_SYNC_REMOTE_FOLDER=/images

# Optional: fetch remote cover images (deprecated — social images are no longer
# generated locally, ImageKit handles cropping at request time)
# SOCIAL_IMAGE_PROXY_URL=
# SOCIAL_IMAGE_ALLOWED_HOSTS=